# Python environment and caches
/venv/
__pycache__/
*.pyc
.pytest_cache/

# Market data: raw downloads and live recordings (large, re-downloadable / re-recordable).
# Anchored with a leading slash so the code package obi/data/ is NOT ignored.
/data/

# Regenerable analysis caches (GBs); report write-ups (.md) and models/*.json stay tracked
*.parquet
*.part
# Report tables are regenerated by the scripts; the .md write-ups are tracked
reports/**/*.csv

# Logs and run output
*.log

# OS / editor
.DS_Store
.vscode/
.idea/
